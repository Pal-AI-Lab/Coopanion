{
  "name": "cortico-world-desktop-pet",
  "version": "0.1.4",
  "type": "module",
  "description": "Cortico World: a desktop pet that talks in bubbles, asks with options, walks, emotes, and hears you through FunASR (SenseVoice on sherpa-onnx)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pal-AI-Lab/Coopanion.git",
    "directory": "packages/cortico-world-desktop-pet"
  },
  "homepage": "https://github.com/Pal-AI-Lab/Coopanion/tree/main/packages/cortico-world-desktop-pet#readme",
  "bugs": {
    "url": "https://github.com/Pal-AI-Lab/Coopanion/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "desktop-pet",
    "funasr"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web/*": "./web/*",
    "./host/*": "./host/*"
  },
  "cortico": {
    "kind": "world",
    "api": 5,
    "consoleClient": "dist/console.js",
    "consoleStyle": "dist/console.css"
  },
  "files": [
    "src",
    "web",
    "host",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build-console.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "koffi": "3.3.1",
    "opencc-js": "^1.4.1",
    "sherpa-onnx-node": "1.13.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "electron": "44.4.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
