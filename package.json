{
  "name": "corti-companion",
  "productName": "CortiCompanion",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop companion built on Cortico: a pet on your screen that talks, listens and can operate the computer",
  "license": "MIT",
  "author": "Pal-AI-Lab",
  "homepage": "https://github.com/Pal-AI-Lab/Coopanion",
  "type": "module",
  "main": "app/main.cjs",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/stage.ts && electron .",
    "start": "electron .",
    "build:cortico": "tsx scripts/stage.ts",
    "build:installer": "tsx scripts/stage.ts && tsx scripts/pack.ts",
    "build:icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "cortico-provider-deepseek": "workspace:*",
    "cortico-world-cua": "workspace:*",
    "cortico-world-desktop-pet": "workspace:*",
    "express": "^4.22.3",
    "pnpm": "11.5.0",
    "tsx": "^4.23.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "electron": "44.4.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-textarea-autosize": "^8.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
