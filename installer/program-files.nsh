; Top-level names owned by released Windows installers. Keep retired names for upgrades.
!macro forProgramFiles OP
  !insertmacro ${OP} "Coopanion.exe"
  !insertmacro ${OP} "resources"
  !insertmacro ${OP} "locales"
  !insertmacro ${OP} "Uninstall Coopanion.exe"
  !insertmacro ${OP} "chrome_100_percent.pak"
  !insertmacro ${OP} "chrome_200_percent.pak"
  !insertmacro ${OP} "d3dcompiler_47.dll"
  !insertmacro ${OP} "dxcompiler.dll"
  !insertmacro ${OP} "dxil.dll"
  !insertmacro ${OP} "ffmpeg.dll"
  !insertmacro ${OP} "icudtl.dat"
  !insertmacro ${OP} "libEGL.dll"
  !insertmacro ${OP} "libGLESv2.dll"
  !insertmacro ${OP} "LICENSE.electron.txt"
  !insertmacro ${OP} "LICENSES.chromium.html"
  !insertmacro ${OP} "resources.pak"
  !insertmacro ${OP} "snapshot_blob.bin"
  !insertmacro ${OP} "v8_context_snapshot.bin"
  !insertmacro ${OP} "vk_swiftshader.dll"
  !insertmacro ${OP} "vk_swiftshader_icd.json"
  !insertmacro ${OP} "vulkan-1.dll"
!macroend
